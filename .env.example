# Virtuoso CMS — Environment Variables Example
# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials to Git.

# Public Application Settings (safe for browser exposure)
NEXT_PUBLIC_APP_NAME="Virtuoso CMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server Hosting URL (optional; e.g. Cloud Run / AI Studio runtime service URL)
APP_URL=""

# Supabase Configuration (will be connected in a later stage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-Only Credentials (NEVER prefix with NEXT_PUBLIC_ or import in Client Components)
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: default Super Admin email for local CLI authentication (still prompts for Auth password)
VIRTUOSO_ADMIN_EMAIL=""

